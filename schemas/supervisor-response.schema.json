{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "improve"]
    },
    "feedback": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "commitMessage": {
      "type": "string",
      "minLength": 3,
      "maxLength": 72
    }
  },
  "required": ["verdict", "feedback", "checks", "commitMessage"],
  "additionalProperties": false
}
