[Unit]
Description=Kiddo Programmer web app workshop
Documentation=https://github.com/gmagogsfm/KiddoProgrammer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@KIDDO_USER@
Group=@KIDDO_GROUP@
WorkingDirectory=@KIDDO_ROOT@
EnvironmentFile=-@KIDDO_CONFIG@
Environment=NODE_ENV=production
Environment=KIDDO_AGENT=@KIDDO_AGENT@
Environment=HOME=@KIDDO_HOME@
Environment=PATH=@KIDDO_BIN_PATH@
Environment=CODEX_BIN=@KIDDO_CODEX_BIN@
ExecStart=@KIDDO_NODE_BIN@ @KIDDO_ROOT@/server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@KIDDO_PROJECTS_DIR@ @KIDDO_CODEX_HOME@
UMask=0077

[Install]
WantedBy=multi-user.target
